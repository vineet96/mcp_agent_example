# Copy to .env. ADK auto-loads .env from this folder for `adk web`.
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# MCP server URL. For local dev, run weather_mcp_server on port 8080.
# For deployed runs, point this at the Cloud Run URL of your MCP server.
WEATHER_MCP_URL=http://localhost:8080/mcp
